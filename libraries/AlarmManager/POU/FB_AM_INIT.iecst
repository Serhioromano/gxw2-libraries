iAN := LIMITATION(0, iNum, c_AM_ALARMS_NUM);

AM_ALARMS[iAN].Buzzer := xBuzzer;
AM_ALARMS[iAN].Latch := xLatch;
AM_ALARMS[iAN].autoReset := xAutoReset;
AM_ALARMS[iAN].Lock := xLock;
AM_ALARMS[iAN].Delay := iDelay;
AM_ALARMS[iAN].Sevirity := iSeverity;
AM_ALARMS[iAN].Process:= iProcess;
AM_ALARMS[iAN].Alarm := FALSE;
